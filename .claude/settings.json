{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/sonda_salvataggi.py *)",
      "Bash(python3 tools/sonda_salvataggi.py *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/controlla_py.py"],
            "timeout": 30,
            "statusMessage": "Controllo del file appena scritto"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/prova_salvataggi.py"],
            "timeout": 300,
            "statusMessage": "Prova dei salvataggi prima del commit"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/prova_salvataggi.py"],
            "timeout": 300,
            "statusMessage": "Prova dei salvataggi prima del commit"
          }
        ]
      }
    ]
  }
}
